{
  config,
  lib,
  matugenAbsPath,
  ...
}: let
  base = ''
    -- Generated by Matugen

    require('base16-colorscheme').setup({
      -- Background / surface ramp (M3 surfaces)
      base00 = "{{m3.surface.default.hex}}",
      base01 = "{{m3.surface_container_low.default.hex}}",
      base02 = "{{m3.surface_container.default.hex}}",
      base03 = "{{m3.outline_variant.default.hex}}", -- comments, muted
      base04 = "{{m3.on_surface_variant.default.hex}}", -- line numbers, dim
      base05 = "{{m3.on_surface.default.hex}}", -- normal text
      base06 = "{{m3.on_primary_container.default.hex}}", -- bright text
      base07 = "{{m3.surface_bright.default.hex}}",

      -- Accent slots. The harmonised M3 palette only spans two hue families
      -- (the primary/secondary lilac and the tertiary/error pink), so we
      -- spread the base16 accents across both by lightness to keep keywords,
      -- functions, strings and numbers distinguishable: strings take the
      -- saturated pink, the structural/code tokens take the lilac ramp.
      base08 = "{{m3.error.default.hex}}", -- errors, exceptions, macro
      base09 = "{{m3.secondary.default.hex}}", -- numbers, constants, booleans
      base0A = "{{m3.secondary_fixed.default.hex}}", -- types, preproc, repeats
      base0B = "{{m3.tertiary.default.hex}}", -- strings, symbols
      base0C = "{{m3.tertiary_fixed_dim.default.hex}}", -- special, escapes
      base0D = "{{m3.primary.default.hex}}", -- functions, calls, includes
      base0E = "{{m3.primary_fixed.default.hex}}", -- keywords, conditionals, operators
      base0F = "{{m3.outline.default.hex}}", -- punctuation, tag delimiters
    })


    -- Base16 gives us a solid base, but the harmonised Material palette needs
    -- a few explicit overrides to keep syntax readable and to theme the
    -- plugin surfaces (bufferline, snacks/mini pickers, cmp, Telescope).

    local function set_hl(groups, value)
      for _, g in ipairs(groups) do
        vim.api.nvim_set_hl(0, g, value)
      end
    end

    local on_surface  = "{{m3.on_surface.default.hex}}"
    local dim         = "{{m3.on_surface_variant.default.hex}}"
    local outline     = "{{m3.outline.default.hex}}"
    local primary     = "{{m3.primary.default.hex}}"
    local primary_b   = "{{m3.on_primary_container.default.hex}}"
    local primary_ct  = "{{m3.primary_container.default.hex}}"
    local primary_on  = "{{m3.on_primary_container.default.hex}}"
    local secondary   = "{{m3.secondary.default.hex}}"
    local secondary_ct = "{{m3.secondary_container.default.hex}}"
    local tertiary    = "{{m3.tertiary.default.hex}}"
    local tertiary_ct = "{{m3.tertiary_container.default.hex}}"
    local tertiary_on = "{{m3.on_tertiary_container.default.hex}}"
    local error       = "{{m3.error.default.hex}}"
    local error_ct    = "{{m3.error_container.default.hex}}"
    local surface_ct  = "{{m3.surface_container.default.hex}}"
    local surface_cl  = "{{m3.surface_container_low.default.hex}}"
    local surface_ch  = "{{m3.surface_container_high.default.hex}}"

    -- Comments stay muted + italic (nvim-config also forces this after load)
    set_hl({ 'Comment', 'TSComment', '@comment' }, { fg = outline, italic = true })

    -- Visual selection: filled container with legible text
    vim.api.nvim_set_hl(0, 'Visual', {
      bg = primary_ct,
      fg = primary_on,
    })
    vim.api.nvim_set_hl(0, 'VisualNOS', {
      bg = primary_ct,
      fg = primary_on,
    })

    -- Search: highlight on the tertiary container so it stands out from the bg
    vim.api.nvim_set_hl(0, 'Search', { bg = tertiary_ct, fg = tertiary_on })
    vim.api.nvim_set_hl(0, 'IncSearch', { bg = tertiary, fg = "{{m3.on_tertiary.default.hex}}" })
    vim.api.nvim_set_hl(0, 'CurSearch', { link = 'IncSearch' })

    -- Cursor line + its number, using the surface ramp
    vim.api.nvim_set_hl(0, 'CursorLine', { bg = surface_cl })
    vim.api.nvim_set_hl(0, 'CursorLineNr', { fg = primary, bg = surface_cl, bold = true })
    vim.api.nvim_set_hl(0, 'CursorColumn', { link = 'CursorLine' })
    vim.api.nvim_set_hl(0, 'CursorLineSign', { link = 'SignColumn' })

    -- Match paren should be obvious
    vim.api.nvim_set_hl(0, 'MatchParen', { bg = surface_ch, fg = tertiary, bold = true })

    -- Syntax: keep a clear division between the structural (keyword/control),
    -- functional and value tokens
    set_hl({
      'Keyword', 'TSKeyword', 'TSKeywordFunction', 'TSKeywordOperator',
      'Conditional', 'TSConditional', 'Repeat', 'TSRepeat',
      'Exception', 'TSException', 'Operator', 'TSOperator', '@keyword',
      '@keyword.conditional', '@keyword.repeat', '@keyword.exception',
    }, { fg = primary_b, bold = false })

    set_hl({
      'Function', 'TSFunction', 'TSMethod', 'TSConstructor',
      'Include', 'TSInclude', 'Define', 'Macro', 'Title', 'TSTitle',
      '@function', '@function.call', '@function.method', '@method',
      '@function.method.call', '@constructor', '@include', '@text.title',
    }, { fg = primary })

    set_hl({
      'Type', 'TSType', 'TSTypeBuiltin', 'Structure', 'Typedef',
      'PreProc', '@type', '@type.definition', '@type.builtin', '@preproc',
    }, { fg = secondary })

    set_hl({
      'String', 'TSString', 'Character', 'TSCharacter', 'Symbol', 'TSSymbol',
      '@string', '@string.special', '@string.special.symbol', '@character',
    }, { fg = tertiary })

    set_hl({
      'StringEscape', 'TSStringEscape', '@string.escape',
      'Special', 'SpecialChar', 'TSStringRegex', '@string.regex',
    }, { fg = tertiary_on })

    set_hl({
      'Number', 'TSNumber', 'Float', 'TSFloat', 'Boolean', 'TSBoolean',
      'Constant', 'TSConstant', 'TSConstBuiltin', 'TSConstMacro',
      'Number', '@number', '@float', '@boolean', '@constant',
      '@constant.builtin', '@constant.macro', '@number.float',
    }, { fg = secondary })

    -- Variables / fields stay near the base text for legibility
    set_hl({
      'Identifier', 'TSVariable', 'TSVariableBuiltin', 'TSField',
      'TSProperty', 'TSParameter', 'TSNamespace', '@variable',
      '@variable.builtin', '@field', '@property', '@parameter', '@namespace',
    }, { fg = on_surface })

    -- Punctuation: deliberately muted so it recedes behind the code
    set_hl({
      'Delimiter', 'TSPunctDelimiter', 'TSPunctBracket', 'TSPunctSpecial',
      '@punctuation.delimiter', '@punctuation.bracket', '@punctuation.special',
      'Tag', 'TSTag', 'TSTagDelimiter', 'TSLabel', '@tag', '@tag.delimiter', '@label',
    }, { fg = dim })

    -- Tree-sitter context header
    vim.api.nvim_set_hl(0, 'TreesitterContext', { bg = surface_ct, italic = true })
    vim.api.nvim_set_hl(0, 'TreesitterContextBottom', { fg = surface_ct })

    -- Popup completion menu
    vim.api.nvim_set_hl(0, 'Pmenu', { fg = on_surface, bg = surface_ct })
    vim.api.nvim_set_hl(0, 'PmenuSel', { fg = primary_on, bg = primary_ct })
    vim.api.nvim_set_hl(0, 'PmenuSbar', { bg = "{{m3.surface_container_highest.default.hex}}" })
    vim.api.nvim_set_hl(0, 'PmenuThumb', { bg = primary })

    -- LSP / diagnostics use the two hue families: errors in red, the rest muted
    vim.api.nvim_set_hl(0, 'DiagnosticError', { fg = error })
    vim.api.nvim_set_hl(0, 'DiagnosticWarn', { fg = tertiary })
    vim.api.nvim_set_hl(0, 'DiagnosticInfo', { fg = secondary })
    vim.api.nvim_set_hl(0, 'DiagnosticHint', { fg = dim })
    set_hl({
      'DiagnosticUnderlineError', 'DiagnosticUnderlineWarn',
      'DiagnosticUnderlineInfo', 'DiagnosticUnderlineHint',
    }, { underline = true })
    vim.api.nvim_set_hl(0, 'LspReferenceText', { underline = true, sp = primary })
    vim.api.nvim_set_hl(0, 'LspReferenceRead', { underline = true, sp = primary })
    vim.api.nvim_set_hl(0, 'LspReferenceWrite', { underline = true, sp = tertiary })

    -- Diff / git: subtle container backgrounds, coloured sign text
    vim.api.nvim_set_hl(0, 'DiffAdd', { fg = tertiary, bg = tertiary_ct })
    vim.api.nvim_set_hl(0, 'DiffChange', { fg = secondary, bg = secondary_ct })
    vim.api.nvim_set_hl(0, 'DiffDelete', { fg = error, bg = error_ct })
    vim.api.nvim_set_hl(0, 'DiffText', { fg = on_surface, bg = surface_ch, bold = true })
    set_hl({ 'DiffAdded', 'GitSignsAdd', 'GitSignsAddLn', 'GitSignsAddNr' }, { fg = tertiary })
    set_hl({ 'DiffChanged', 'DiffModified', 'GitSignsChange', 'GitSignsChangeLn', 'GitSignsChangeNr' }, { fg = secondary })
    set_hl({ 'DiffRemoved', 'GitSignsDelete', 'GitSignsDeleteLn', 'GitSignsDeleteNr' }, { fg = error })

    -- Bufferline: keep the tabline flat and continuous (no per-tab solid
    -- boxes) with only the active tab highlighted as a container pill, plus
    -- slanted separators carved to blend into the fill. This reads far more
    -- naturally than blocky per-tab backgrounds.
    vim.api.nvim_set_hl(0, 'BufferLineFill', { fg = dim, bg = surface_ct })
    vim.api.nvim_set_hl(0, 'BufferLineBuffer', { fg = dim, bg = 'none' })
    vim.api.nvim_set_hl(0, 'BufferLineBufferVisible', { fg = dim, bg = 'none' })
    vim.api.nvim_set_hl(0, 'BufferLineBufferSelected', { fg = primary_on, bg = primary_ct, bold = true })
    vim.api.nvim_set_hl(0, 'BufferLineIndicatorSelected', { fg = primary })
    vim.api.nvim_set_hl(0, 'BufferLineSeparator', { fg = surface_ct, bg = surface_ct })
    vim.api.nvim_set_hl(0, 'BufferLineSeparatorSelected', { fg = primary_ct, bg = primary_ct })
    set_hl({
      'BufferLineError', 'BufferLineErrorDiagnostic', 'BufferLineErrorDiagnosticVisible',
    }, { fg = error })
    set_hl({
      'BufferLineWarning', 'BufferLineWarningDiagnostic', 'BufferLineWarningDiagnosticVisible',
    }, { fg = tertiary })

    -- Snacks / Telescope picker surfaces
    vim.api.nvim_set_hl(0, 'SnacksPickerBorder', { fg = surface_ch, bg = surface_ct })
    vim.api.nvim_set_hl(0, 'SnacksPickerPrompt', { fg = on_surface })
    vim.api.nvim_set_hl(0, 'SnacksPickerTitle', { fg = on_surface, bold = true })
    vim.api.nvim_set_hl(0, 'SnacksPickerInputTitle', { fg = primary, bold = true })
    vim.api.nvim_set_hl(0, 'SnacksPickerListCursorLine', { fg = primary_on, bg = primary_ct })
    vim.api.nvim_set_hl(0, 'TelescopeBorder', { fg = surface_ch, bg = surface_ct })
    vim.api.nvim_set_hl(0, 'TelescopePromptTitle', { fg = on_surface, bg = primary_ct })
    vim.api.nvim_set_hl(0, 'TelescopeResultsTitle', { fg = dim, bg = surface_ct })
    vim.api.nvim_set_hl(0, 'TelescopeSelection', { fg = primary_on, bg = primary_ct })
    vim.api.nvim_set_hl(0, 'TelescopePreviewTitle', { fg = on_surface, bg = tertiary_ct })

    -- Status line / winbar
    vim.api.nvim_set_hl(0, 'StatusLine', { fg = on_surface, bg = surface_ct })
    vim.api.nvim_set_hl(0, 'StatusLineNC', { fg = dim, bg = surface_cl })
    vim.api.nvim_set_hl(0, 'WinBar', { fg = dim })
    vim.api.nvim_set_hl(0, 'WinBarNC', { fg = outline })
    vim.api.nvim_set_hl(0, 'SignColumn', { fg = dim, bg = "{{m3.surface.default.hex}}" })
    vim.api.nvim_set_hl(0, 'LineNr', { fg = outline })
  '';
in {
  config = lib.mkIf config.home.matugen.enable {
    home.file."${matugenAbsPath}/nvim.lua".text = base;
  };
}
