{
  config,
  lib,
  ...
}: let
  cfg = config.home.dev;
  nvimConfigDir = "${config.home.homeDirectory}/.config/nvim";

  palette = import ../theme/palette.nix {inherit lib;};

  caelestiaStatePath = "${config.home.homeDirectory}/.local/state/caelestia/theme/nvim.lua";

  base16Names = [
    "base00"
    "base01"
    "base02"
    "base03"
    "base04"
    "base05"
    "base06"
    "base07"
    "base08"
    "base09"
    "base0A"
    "base0B"
    "base0C"
    "base0D"
    "base0E"
    "base0F"
  ];
  base16 = lib.genAttrs base16Names (name: palette.colors.${name});

  fallbackRoles = {
    surface = palette.colors.base00;
    surfaceContainer = palette.colors.base01;
    surfaceContainerHigh = palette.colors.surfaceHigh;
    onSurface = palette.colors.base06;
    onSurfaceVariant = palette.colors.base04;
    outline = palette.colors.base03;
    outlineVariant = palette.colors.outlineVariant;
    subtext0 = palette.colors.base03;
    subtext1 = palette.colors.base04;
    primary = palette.colors.base0E;
    onPrimary = palette.colors.onPrimary;
    red = palette.colors.base08;
    maroon = palette.colors.base0F;
    peach = palette.colors.base09;
    yellow = palette.colors.base0A;
    green = palette.colors.base0B;
    teal = palette.colors.base0C;
    sky = palette.colors.base0C;
    sapphire = palette.colors.base0D;
    blue = palette.colors.base0D;
    lavender = palette.colors.base0D;
    mauve = palette.colors.base0E;
    pink = palette.colors.base0E;
    error = palette.colors.error;
    success = palette.colors.base0B;
  };

  header = [
    "-- Generated by Home Manager from modules/home/dev/nvim-theme.nix"
  ];

  paletteLua =
    lib.concatStringsSep "\n" (
      header
      ++ [
        "local M = {}"
        ""
        "local statePath = ${builtins.toJSON caelestiaStatePath}"
        ""
        "local fallback = {"
        (lib.concatStringsSep "\n" (lib.mapAttrsToList (k: v: "  ${k} = \"#${v}\",") (base16 // fallbackRoles)))
        "}"
        ""
        "local ok, colours = pcall(dofile, statePath)"
        "if ok and type(colours) == \"table\" and colours.base00 then"
        "  M.colours = colours"
        "  M.dynamic = true"
        "else"
        "  M.colours = fallback"
        "  M.dynamic = false"
        "end"
        ""
        "return M"
      ]
    )
    + "\n";

  syntaxRoles = {
    "@attribute" = "yellow";
    "@boolean" = "peach";
    "@character" = "red";
    "@constant" = "peach";
    "@constant.builtin" = "peach";
    "@constant.macro" = "peach";
    "@constructor" = "yellow";
    "@enum" = "yellow";
    "@function" = "blue";
    "@function.builtin" = "teal";
    "@function.call" = "blue";
    "@function.macro" = "teal";
    "@function.method" = "blue";
    "@function.method.call" = "blue";
    "@include" = "teal";
    "@keyword" = "pink";
    "@keyword.conditional" = "pink";
    "@keyword.coroutine" = "pink";
    "@keyword.directive" = "teal";
    "@keyword.directive.define" = "teal";
    "@keyword.exception" = "pink";
    "@keyword.function" = "pink";
    "@keyword.import" = "pink";
    "@keyword.operator" = "sapphire";
    "@keyword.repeat" = "pink";
    "@keyword.return" = "pink";
    "@keyword.storage" = "pink";
    "@label" = "yellow";
    "@module" = "onSurface";
    "@namespace" = "onSurface";
    "@number" = "peach";
    "@number.float" = "peach";
    "@operator" = "sapphire";
    "@preproc" = "teal";
    "@property" = "teal";
    "@field" = "teal";
    "@punctuation" = "subtext1";
    "@punctuation.bracket" = "subtext1";
    "@punctuation.delimiter" = "subtext1";
    "@punctuation.special" = "sapphire";
    "@string" = "green";
    "@string.escape" = "pink";
    "@string.regex" = "sky";
    "@string.regexp" = "sky";
    "@string.special" = "green";
    "@string.special.symbol" = "teal";
    "@tag" = "yellow";
    "@tag.attribute" = "yellow";
    "@tag.delimiter" = "subtext1";
    "@type" = "yellow";
    "@type.builtin" = "onSurface";
    "@type.definition" = "yellow";
    "@type.qualifier" = "pink";
    "@variable" = "onSurface";
    "@variable.member" = "teal";
    "@variant" = "peach";
  };
  syntaxOverrideLua = lib.concatStringsSep "\n" (
    lib.mapAttrsToList (group: role: "set(0, ${builtins.toJSON group}, { fg = c.${role} })") syntaxRoles
  );

  syntaxStyledLua = ''
    set(0, "@comment", { fg = c.subtext0, italic = true })
    set(0, "@comment.documentation", { fg = c.subtext0, italic = true })
    set(0, "@parameter", { fg = c.teal })
    set(0, "@variable.parameter", { fg = c.teal })
    set(0, "@variable.builtin", { fg = c.onSurface, italic = true })
    set(0, "@variable.special", { fg = c.onSurface, italic = true })
    set(0, "@type.super", { fg = c.yellow, italic = true })
    set(0, "@text.emphasis", { fg = c.red, italic = true })
    set(0, "@text.title", { fg = c.blue, bold = true })
    set(0, "@markup.heading", { fg = c.blue, bold = true })
    set(0, "@text.uri", { fg = c.teal, underline = true })
    set(0, "@string.special.url", { fg = c.teal, underline = true })
    set(0, "@markup.link.url", { fg = c.teal, underline = true })
  '';

  bufferlineLua = ''
    set(0, "BufferLineFill", { bg = c.surface })
    set(0, "BufferLineBackground", { fg = c.onSurfaceVariant, bg = c.surface })
    set(0, "BufferLineBuffer", { fg = c.onSurfaceVariant, bg = c.surface })
    set(0, "BufferLineBufferSelected", { fg = c.onSurface, bg = c.surfaceContainerHigh, bold = true })
    set(0, "BufferLineBufferVisible", { fg = c.onSurfaceVariant, bg = c.surface })
    set(0, "BufferLineTab", { fg = c.onSurfaceVariant, bg = c.surface })
    set(0, "BufferLineTabSelected", { fg = c.onSurface, bg = c.surfaceContainerHigh })
    set(0, "BufferLineTabClose", { fg = c.red, bg = c.surface })
    set(0, "BufferLineIndicatorSelected", { fg = c.primary, bg = c.surfaceContainerHigh })
    set(0, "BufferLineSeparator", { fg = c.surface, bg = c.surface })
    set(0, "BufferLineSeparatorSelected", { fg = c.surfaceContainerHigh, bg = c.surfaceContainerHigh })
    set(0, "BufferLineCloseButton", { fg = c.onSurfaceVariant, bg = c.surface })
    set(0, "BufferLineCloseButtonSelected", { fg = c.red, bg = c.surfaceContainerHigh })
    set(0, "BufferLineModified", { fg = c.yellow, bg = c.surface })
    set(0, "BufferLineModifiedSelected", { fg = c.yellow, bg = c.surfaceContainerHigh })
    set(0, "BufferLineModifiedVisible", { fg = c.yellow, bg = c.surface })
    set(0, "BufferLineDiagnostic", { fg = c.onSurfaceVariant, bg = c.surface })
    set(0, "BufferLineDuplicate", { fg = c.onSurfaceVariant, bg = c.surface })
  '';

  colorsLua =
    lib.concatStringsSep "\n" (
      header
      ++ [
        "local c = require(\"caelestia\").colours"
        "require(\"base16-colorscheme\").setup(c)"
        ""
        "local set = vim.api.nvim_set_hl"
        ""
        "-- Mirror zed.json's syntax mapping so tokens match the editor."
        syntaxOverrideLua
        ""
        syntaxStyledLua
        "-- Tab bar, matching Zed's title_bar/tab colours."
        bufferlineLua
        "-- `:colorscheme` sets this itself, but a direct dofile/require would"
        "-- not; lualine resolves its 'auto' theme from it."
        "vim.g.colors_name = \"caelestia\""
      ]
    )
    + "\n";

  lualineSection = bg: fg: ''
    {
      a = { bg = ${bg}, fg = c.base00, gui = "bold" },
      b = { bg = c.base01, fg = ${fg} },
      c = { bg = c.base01, fg = c.base05 },
    }'';

  lualineLua =
    lib.concatStringsSep "\n" (
      header
      ++ [
        "local c = require(\"caelestia\").colours"
        ""
        "return {"
        "  normal = ${lualineSection "c.base0E" "c.base0E"},"
        "  insert = ${lualineSection "c.base0B" "c.base0B"},"
        "  replace = ${lualineSection "c.base08" "c.base08"},"
        "  visual = ${lualineSection "c.base02" "c.base02"},"
        "  command = ${lualineSection "c.base0D" "c.base0D"},"
        "  terminal = ${lualineSection "c.base0C" "c.base0C"},"
        "  inactive = {"
        "    a = { bg = c.base01, fg = c.base04 },"
        "    b = { bg = c.base01, fg = c.base04 },"
        "    c = { bg = c.base01, fg = c.base04 },"
        "  },"
        "}"
      ]
    )
    + "\n";

  applyLua =
    lib.concatStringsSep "\n" (
      header
      ++ [
        "local target = \"caelestia\""
        "if vim.g.colors_name ~= target then"
        "  local ok, err = pcall(vim.cmd.colorscheme, target)"
        "  if not ok then"
        "    vim.notify("
        "      \"Could not load \" .. target .. \": \" .. tostring(err),"
        "      vim.log.levels.WARN,"
        "      { title = target }"
        "    )"
        "  end"
        "end"
      ]
    )
    + "\n";
in {
  config = lib.mkIf cfg.enable {
    home.file."${nvimConfigDir}/lua/caelestia.lua".text = paletteLua;
    home.file."${nvimConfigDir}/colors/caelestia.lua".text = colorsLua;
    home.file."${nvimConfigDir}/lua/lualine/themes/caelestia.lua".text = lualineLua;
    home.file."${nvimConfigDir}/plugin/theme.lua".text = applyLua;
  };
}
