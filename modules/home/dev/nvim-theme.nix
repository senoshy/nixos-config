{
  config,
  lib,
  ...
}: let
  cfg = config.home.dev;
  nvimConfigDir = "${config.home.homeDirectory}/.config/nvim";

  # Amber CRT palette. Kept in sync by hand with
  # modules/home/hyprland/colors.lua and modules/home/kitty/kitty.conf.
  p = {
    background = "#0d0b06";
    sunken = "#060503";
    surface = "#14110a";
    raised = "#1a1610";
    raised_high = "#241f16";
    raised_highest = "#2e281c";
    surface_variant = "#3a3020";
    outline = "#4a3d1c";
    outline_dim = "#5c4c25";
    grey = "#6e5c2e";
    light_grey = "#8a7339";
    dim = "#c9a45c";
    text = "#f0c674";
    text_bright = "#ffd08a";
    primary = "#ffb638";
    secondary = "#c98a2a";
    tertiary = "#d9a441";
    beige = "#e8cfa0";
    baby_pink = "#e8a06a";
    red = "#d4654a";
    brown_red = "#8a3a2a";
    brown = "#7a4d00";
    green = "#a8b85a";
    dark_green = "#6b7a3a";
    deep_green = "#3a4a1e";
    soft_green = "#b8c46a";
    teal = "#5aa88a";
    cyan = "#7fc4a8";
    blue = "#7a86a8";
    deep_blue = "#4a5570";
    purple = "#b85a6b";
    dark_purple = "#8a4a5c";
    violet = "#9c6a9c";
    lavender = "#b8a6d0";
  };

  base_30 = {
    accent = p.primary;
    baby_pink = p.baby_pink;
    base0D = p.blue;
    base0F = p.purple;
    beige = p.beige;
    black = p.background;
    black2 = p.surface;
    blue = p.blue;
    brown = p.brown;
    brownred = p.brown_red;
    coal = p.surface;
    cyan = p.cyan;
    darkgreen = p.deep_green;
    dark_purple = p.dark_purple;
    deep_black = p.sunken;
    faded_grey = p.outline_dim;
    firered = p.red;
    folder_bg = p.primary;
    gray_fg = p.grey;
    green = p.green;
    green1 = p.dark_green;
    grey = p.outline;
    grey_fg = p.outline_dim;
    lavender = p.lavender;
    light_grey = p.light_grey;
    lightgray = p.light_grey;
    lightbg = p.raised_highest;
    line = p.surface_variant;
    nord_blue = p.deep_blue;
    note = p.green;
    ogwhite = p.text_bright;
    one_bg = p.raised;
    one_bg2 = p.raised_high;
    one_bg3 = p.raised_highest;
    orange = p.secondary;
    orange2 = p.tertiary;
    pale_blue = p.blue;
    pink = p.dim;
    pmenu_bg = p.outline;
    purple = p.purple;
    red = p.red;
    seablue = p.deep_blue;
    soft_green = p.soft_green;
    statusline_bg = p.raised;
    sun = p.text_bright;
    tan = p.beige;
    taupe = p.grey;
    teal = p.teal;
    todo = p.secondary;
    turquoise = p.cyan;
    vibrant_green = p.soft_green;
    violet = p.violet;
    white = p.text;
    white2 = p.primary;
    yellow = p.primary;
  };

  base_16 = {
    base00 = p.background;
    base01 = p.raised;
    base02 = p.raised_high;
    base03 = p.outline_dim;
    base04 = p.light_grey;
    base05 = p.dim;
    base06 = p.text;
    base07 = p.text_bright;
    base08 = p.red;
    base09 = p.secondary;
    base0A = p.tertiary;
    base0B = p.green;
    base0C = p.teal;
    base0D = p.blue;
    base0E = p.primary;
    base0F = p.purple;
  };

  luaEntries = name: attrs:
    lib.concatStringsSep "\n" (
      lib.mapAttrsToList (key: value: "  ${key} = \"${value}\",") attrs
    )
    + "\n";

  themeLua = ''
    -- Generated by Home Manager from modules/home/dev/nvim-theme.nix
    -- Amber CRT theme for AvengeMedia/base46 v3.0.
    local M = {}

    M.base_30 = {
    ${luaEntries "base_30" base_30}    }

    M.base_16 = {
    ${luaEntries "base_16" base_16}    }

    M.type = "dark"

    M = require("base46").override_theme(M, "amber-crt")

    return M
  '';

  colorsLua = ''
    -- Generated by Home Manager from modules/home/dev/nvim-theme.nix
    require("base46").load("amber-crt")
  '';

  lualineLua = ''
    -- Generated by Home Manager from modules/home/dev/nvim-theme.nix
    return require("lualine.themes._base46")("amber-crt")
  '';

  # The nix-managed init applies base46's own default theme ("kanagawa") before
  # any runtimepath plugin/ file is sourced, so the theme is swapped here. This
  # also runs before lualine's VeryLazy setup, so `theme = "auto"` resolves to
  # lualine.themes.base46-amber-crt.
  applyLua = ''
    -- Generated by Home Manager from modules/home/dev/nvim-theme.nix
    if vim.g.colors_name ~= "base46-amber-crt" then
      local ok, err = pcall(vim.cmd.colorscheme, "base46-amber-crt")
      if not ok then
        vim.notify(
          "Could not load base46-amber-crt: " .. tostring(err),
          vim.log.levels.WARN,
          { title = "amber-crt" }
        )
      end
    end
  '';
in {
  config = lib.mkIf cfg.enable {
    home.file."${nvimConfigDir}/lua/base46/themes/amber-crt.lua".text = themeLua;
    home.file."${nvimConfigDir}/colors/base46-amber-crt.lua".text = colorsLua;
    home.file."${nvimConfigDir}/lua/lualine/themes/base46-amber-crt.lua".text = lualineLua;
    home.file."${nvimConfigDir}/plugin/amber-crt.lua".text = applyLua;
  };
}
